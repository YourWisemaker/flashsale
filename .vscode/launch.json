{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=../../.env", "--import", "tsx"],
      "program": "src/server.ts",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Worker (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/worker",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=../../.env", "--import", "tsx"],
      "program": "src/index.ts",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Vitest: current file",
      "type": "node",
      "request": "launch",
      "cwd": "${fileDirname}",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vitest", "run", "${file}"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach :9229",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
