{
  "name": "@flashsale/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/index.js",
    "clean": "rm -rf dist",
    "lint": "echo 'no lint configured for worker'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@flashsale/core": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "mongodb": "^6.11.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8",
    "@stryker-mutator/vitest-runner": "^8",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
