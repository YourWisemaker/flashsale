{
  "name": "flashsale",
  "description": "High-throughput flash sale system: Fastify API, BullMQ worker, React frontend, MongoDB + Redis.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "clean": "turbo clean && rm -rf node_modules",
    "seed": "pnpm cli seed",
    "dlq:replay": "pnpm cli dlq:replay",
    "reconcile": "pnpm cli reconcile",
    "stress": "pnpm --filter @flashsale/stress run stress",
    "test:e2e": "pnpm --filter @flashsale/web run test:e2e",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "test:mutation": "turbo test:mutation",
    "docs": "pnpm --filter @flashsale/docs docs",
    "test:python": ".venv/bin/python -m pytest tests/python -q",
    "cli": "pnpm --filter @flashsale/cli run cli"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0"
  }
}
