{
  "name": "@flashsale/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "lint": "echo 'no lint configured for core'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "echo 'no integration tests in core'",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "fast-jwt": "^5",
    "ioredis": "^5.4.1",
    "mongodb": "^6.11.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8",
    "@stryker-mutator/vitest-runner": "^8",
    "fast-check": "^3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
