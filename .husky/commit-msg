# Conventional Commits: type(optional-scope)!: summary
# Types: feat fix docs style refactor perf test build ci chore revert
first_line=$(head -n1 "$1")
case "$first_line" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;; esac
if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./-]+\))?!?: .+'; then
  echo "commit-msg: use Conventional Commits, e.g. 'feat(api): add load shedding' or 'fix(ci): mongo health check'" >&2
  echo "  got: $first_line" >&2
  exit 1
fi
