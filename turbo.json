{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "TEST_REDIS_URL",
    "TEST_MONGO_URL",
    "REDIS_URL",
    "MONGO_URL",
    "RATE_LIMIT_MAX",
    "WORKER_CONCURRENCY",
    "PORT",
    "API_PROCESSES",
    "STRESS_API_URL",
    "STRESS_CONCURRENCY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    },
    "test:mutation": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
