{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "TEST_REDIS_URL",
    "TEST_MONGO_URL",
    "REDIS_URL",
    "MONGO_URL",
    "RATE_LIMIT_MAX",
    "WORKER_CONCURRENCY",
    "PORT",
    "AUTH_SECRET",
    "AUTH_RATE_LIMIT_MAX",
    "WEB_URL",
    "COOKIE_SECURE",
    "NODE_ENV",
    "API_PROCESSES",
    "MAX_EVENT_LOOP_LAG_MS",
    "STRESS_API_URL",
    "STRESS_CONCURRENCY",
    "MEMORY_TRACKER",
    "FREEZE_PROFILER",
    "FREEZE_THRESHOLD_MS",
    "FREEZE_PROFILE_DIR",
    "FREEZE_PROFILE_S3_BUCKET",
    "ANTHROPIC_API_KEY",
    "AWS_REGION",
    "AWS_PROFILE",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    },
    "test:mutation": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
