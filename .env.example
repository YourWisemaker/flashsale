# Copy to .env and adjust. All values here have working defaults.

# --- Sale window ---
# ISO 8601 timestamps. If left unset, the seed script defaults to
# "starts 1 minute from now" and "ends 1 hour after that".
SALE_START=
SALE_END=
SALE_STOCK=100

# --- Infra ---
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017/flashsale

# --- API ---
# Signs session cookies. Use a long random value outside development
# (e.g. `openssl rand -base64 48`); the API refuses to start in production without one.
AUTH_SECRET=dev-only-secret-do-not-use-in-production
# Login / sign-up / password reset attempts per IP per minute.
AUTH_RATE_LIMIT_MAX=10
# Public web URL, used in password reset emails.
WEB_URL=http://localhost:5173
PORT=3000
# Purchase attempts per user per second before the API returns 429.
# The stress test script overrides this on the fly, see stress/README.md.
RATE_LIMIT_MAX=5

# --- Worker ---
WORKER_CONCURRENCY=10

# --- Frontend (apps/web) ---
VITE_API_URL=http://localhost:3000
# Public URL of the web app, used for canonical and Open Graph tags.
VITE_SITE_URL=http://localhost:5173
