{
  "info": {
    "name": "Arief Shop Flash Sale API",
    "description": "Every endpoint of the flash sale API. Run `pnpm cli seed --force --start now --minutes 60`, then run the folders top to bottom.\n\nAuth is a `session` cookie: Postman keeps it after **Log in**, so the Purchase requests just work. The spec lives in `apps/api/openapi.yaml`; Swagger UI at {{baseUrl}}/docs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "demo@example.com"
    },
    {
      "key": "password",
      "value": "FlashSale2026!"
    }
  ],
  "item": [
    {
      "name": "Sale",
      "item": [
        {
          "name": "Sale status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sale",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sale"
              ]
            },
            "description": "Window, stock and status. Unlimited; a CDN may cache it 1s."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is known', () => pm.expect(['upcoming','active','ended','sold_out']).to.include(body.status));",
                  "pm.test('stock in range', () => pm.expect(body.stockLeft).to.be.within(0, body.totalStock));"
                ]
              }
            }
          ]
        },
        {
          "name": "Product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/product",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "product"
              ]
            },
            "description": "Display data, cached 60s. 404 until seeded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "200 when Redis and Mongo respond, else 503."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Sets the session cookie. Same 401 for unknown email and wrong password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('session cookie set', () => pm.expect(pm.cookies.has('session')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "The logged-in email, or 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates an account and logs in. 409 if the email is taken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman-{{$timestamp}}@example.com\",\n  \"password\": \"Sneakers2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot"
              ]
            },
            "description": "Same 202 whether or not the account exists. Read the link with `pnpm cli outbox`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "reset"
              ]
            },
            "description": "Paste the token from the outbox link. Single use, 30 minutes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"paste-token-from-outbox\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Clears the cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Purchase",
      "description": "Run **Auth / Log in** first.",
      "item": [
        {
          "name": "Buy without a session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/purchase",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "purchase"
              ]
            },
            "description": "401 before any stock is touched. Runs right after Auth / Log out, so there's no cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('unauthorized', () => pm.expect(pm.response.json().error).to.eql('unauthorized'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as demo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Same as Auth / Log in, here so this folder runs on its own.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Buy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "purchase"
              ]
            },
            "description": "202 pending on a win, 409 already_purchased, 410 sold_out, 403 upcoming/ended. A fresh Idempotency-Key per send."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a purchase outcome', () => pm.expect([202, 403, 409, 410]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buy again with the same key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "replay-demo-key-0001"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "purchase"
              ]
            },
            "description": "Replays the stored answer with Idempotent-Replayed: true. Set the key to one you already sent."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.headers.get('Idempotent-Replayed')) pm.test('replayed', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Did I get one?",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/purchase/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "purchase",
                "me"
              ]
            },
            "description": "none, pending, or confirmed. Only your own."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('known status', () => pm.expect(['none','pending','confirmed']).to.include(pm.response.json().status));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}